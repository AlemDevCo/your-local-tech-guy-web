<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Book a Service — Your Local Tech Guy</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --green: #7ec832;
    --green-dark: #5fa020;
    --green-light: #a8e05a;
    --green-dim: rgba(126,200,50,0.1);
    --green-border: rgba(126,200,50,0.25);
    --bg: #0e0f0c;
    --bg2: #141510;
    --bg3: #1a1c16;
    --border: rgba(255,255,255,0.07);
    --text: #e8edd8;
    --muted: rgba(232,237,216,0.45);
    --dim: rgba(232,237,216,0.15);
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'DM Sans', sans-serif;
    min-height: 100vh;
    line-height: 1.6;
  }

  /* NAV */
  nav {
    padding: 16px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
    background: rgba(14,15,12,0.95);
    position: sticky; top: 0; z-index: 100;
    backdrop-filter: blur(10px);
  }

  .nav-logo {
    display: flex; align-items: center; gap: 10px;
    text-decoration: none;
  }

  .nav-logo-icon {
    width: 32px; height: 32px;
    background: var(--green);
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px;
  }

  .nav-logo-text {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.2px;
  }

  .nav-logo-text span { color: var(--green); }

  .nav-back {
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
    display: flex; align-items: center; gap: 6px;
    transition: color 0.2s;
  }
  .nav-back:hover { color: var(--green); }

  /* HERO */
  .hero {
    padding: 56px 32px 40px;
    max-width: 760px;
    margin: 0 auto;
  }

  .hero-tag {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--green-dim);
    border: 1px solid var(--green-border);
    color: var(--green);
    font-size: 11px;
    font-family: 'DM Mono', monospace;
    letter-spacing: 1.5px;
    padding: 4px 10px;
    border-radius: 4px;
    margin-bottom: 16px;
  }

  .hero-tag::before {
    content: '';
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--green);
    animation: pulse 2s infinite;
  }

  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }

  .hero h1 {
    font-size: 36px;
    font-weight: 600;
    letter-spacing: -0.5px;
    color: var(--text);
    margin-bottom: 10px;
    line-height: 1.2;
  }

  .hero h1 span { color: var(--green); }

  .hero p {
    font-size: 15px;
    color: var(--muted);
    max-width: 480px;
  }

  /* PROGRESS */
  .progress-wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 32px 32px;
  }

  .progress-steps {
    display: flex;
    align-items: center;
    gap: 0;
  }

  .step {
    display: flex; align-items: center; gap: 8px;
    flex: 1;
  }

  .step-num {
    width: 28px; height: 28px;
    border-radius: 50%;
    border: 1.5px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    font-size: 12px;
    font-family: 'DM Mono', monospace;
    color: var(--muted);
    background: var(--bg2);
    flex-shrink: 0;
    transition: all 0.3s;
  }

  .step.active .step-num {
    border-color: var(--green);
    background: var(--green);
    color: #000;
    font-weight: 700;
  }

  .step.done .step-num {
    border-color: var(--green);
    background: var(--green-dim);
    color: var(--green);
  }

  .step-label {
    font-size: 12px;
    color: var(--muted);
    font-weight: 500;
    transition: color 0.3s;
  }

  .step.active .step-label { color: var(--text); }
  .step.done .step-label { color: var(--green); }

  .step-line {
    flex: 1;
    height: 1px;
    background: var(--border);
    margin: 0 8px;
    transition: background 0.3s;
  }
  .step-line.done { background: var(--green-border); }

  /* MAIN CONTENT */
  .main {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 32px 80px;
  }

  /* STEP PANELS */
  .step-panel { display: none; }
  .step-panel.active { display: block; }

  /* SERVICE CARDS */
  .section-title {
    font-size: 13px;
    font-family: 'DM Mono', monospace;
    letter-spacing: 1.5px;
    color: var(--muted);
    margin-bottom: 16px;
    text-transform: uppercase;
  }

  .service-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 32px;
  }

  .service-card {
    background: var(--bg2);
    border: 1.5px solid var(--border);
    border-radius: 10px;
    padding: 18px;
    cursor: pointer;
    transition: all 0.2s;
    position: relative;
    overflow: hidden;
  }

  .service-card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: var(--green);
    transform: scaleX(0);
    transition: transform 0.2s;
    transform-origin: left;
  }

  .service-card:hover {
    border-color: var(--green-border);
    background: var(--bg3);
  }

  .service-card:hover::before { transform: scaleX(1); }

  .service-card.selected {
    border-color: var(--green);
    background: var(--bg3);
  }

  .service-card.selected::before { transform: scaleX(1); }

  .service-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
  }

  .service-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
  }

  .service-price {
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    color: var(--green);
    background: var(--green-dim);
    border: 1px solid var(--green-border);
    padding: 2px 8px;
    border-radius: 4px;
    white-space: nowrap;
  }

  .service-desc {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.5;
  }

  .service-check {
    position: absolute;
    top: 12px; right: 12px;
    width: 18px; height: 18px;
    border-radius: 50%;
    background: var(--green);
    display: none;
    align-items: center; justify-content: center;
    font-size: 10px;
    color: #000;
    font-weight: 700;
  }

  .service-card.selected .service-check { display: flex; }
  .service-card.selected .service-card-header { padding-right: 24px; }

  /* DATE PICKER */
  .date-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
    margin-bottom: 24px;
  }

  .day-label {
    text-align: center;
    font-size: 11px;
    font-family: 'DM Mono', monospace;
    color: var(--dim);
    padding-bottom: 6px;
    letter-spacing: 1px;
  }

  .date-cell {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    font-size: 13px;
    cursor: pointer;
    border: 1px solid transparent;
    transition: all 0.15s;
    color: var(--muted);
  }

  .date-cell:hover:not(.disabled):not(.empty) {
    border-color: var(--green-border);
    color: var(--text);
    background: var(--bg3);
  }

  .date-cell.selected {
    background: var(--green);
    color: #000;
    font-weight: 600;
  }

  .date-cell.today {
    border-color: var(--green-border);
    color: var(--green);
  }

  .date-cell.disabled {
    opacity: 0.25;
    cursor: not-allowed;
  }

  .date-cell.empty { cursor: default; }

  .month-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .month-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
  }

  .month-btn {
    width: 32px; height: 32px;
    border: 1px solid var(--border);
    background: var(--bg2);
    color: var(--muted);
    border-radius: 6px;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px;
    transition: all 0.15s;
  }
  .month-btn:hover { border-color: var(--green-border); color: var(--green); }

  /* TIME SLOTS */
  .time-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-bottom: 32px;
  }

  .time-slot {
    padding: 10px;
    text-align: center;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 13px;
    font-family: 'DM Mono', monospace;
    color: var(--muted);
    cursor: pointer;
    background: var(--bg2);
    transition: all 0.15s;
  }

  .time-slot:hover:not(.unavailable) {
    border-color: var(--green-border);
    color: var(--text);
  }

  .time-slot.selected {
    background: var(--green-dim);
    border-color: var(--green);
    color: var(--green);
    font-weight: 500;
  }

  .time-slot.unavailable {
    opacity: 0.3;
    cursor: not-allowed;
    text-decoration: line-through;
  }

  /* FORM */
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 14px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group.full { grid-column: span 2; }

  label {
    font-size: 12px;
    font-family: 'DM Mono', monospace;
    letter-spacing: 1px;
    color: var(--muted);
    text-transform: uppercase;
  }

  input, textarea, select {
    background: var(--bg2);
    border: 1.5px solid var(--border);
    border-radius: 8px;
    padding: 11px 14px;
    color: var(--text);
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s;
    width: 100%;
  }

  input:focus, textarea:focus, select:focus {
    border-color: var(--green);
  }

  input::placeholder, textarea::placeholder { color: var(--dim); }

  textarea { resize: vertical; min-height: 90px; }

  select option { background: var(--bg2); }

  /* DEVICE INFO */
  .device-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 10px;
    margin-bottom: 14px;
  }

  /* SUMMARY */
  .summary-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 20px;
  }

  .summary-section {
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
  }

  .summary-section:last-child { border-bottom: none; }

  .summary-label {
    font-size: 10px;
    font-family: 'DM Mono', monospace;
    letter-spacing: 2px;
    color: var(--muted);
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .summary-value {
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
  }

  .summary-sub {
    font-size: 12px;
    color: var(--muted);
    margin-top: 2px;
  }

  .summary-price {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    background: var(--green-dim);
    border-top: 1px solid var(--green-border);
  }

  .summary-price-label {
    font-size: 13px;
    color: var(--muted);
  }

  .summary-price-val {
    font-family: 'DM Mono', monospace;
    font-size: 20px;
    font-weight: 500;
    color: var(--green);
  }

  /* NOTICE */
  .notice {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-left: 3px solid var(--green);
    border-radius: 0 8px 8px 0;
    padding: 12px 16px;
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 24px;
    line-height: 1.6;
  }

  /* BUTTONS */
  .btn-row {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
    margin-top: 24px;
  }

  .btn {
    padding: 12px 24px;
    border-radius: 8px;
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    border: none;
    letter-spacing: 0.2px;
  }

  .btn-primary {
    background: var(--green);
    color: #000;
  }
  .btn-primary:hover { background: var(--green-light); }
  .btn-primary:disabled { opacity: 0.4; cursor: not-allowed; }

  .btn-secondary {
    background: var(--bg2);
    border: 1px solid var(--border);
    color: var(--muted);
  }
  .btn-secondary:hover { border-color: var(--green-border); color: var(--text); }

  /* SUCCESS */
  .success-wrap {
    text-align: center;
    padding: 60px 20px;
  }

  .success-icon {
    width: 64px; height: 64px;
    background: var(--green-dim);
    border: 2px solid var(--green);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 28px;
    margin: 0 auto 24px;
    animation: popIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes popIn {
    from { transform: scale(0); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  .success-wrap h2 {
    font-size: 24px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 8px;
  }

  .success-wrap p {
    font-size: 14px;
    color: var(--muted);
    max-width: 380px;
    margin: 0 auto 24px;
  }

  .booking-ref {
    display: inline-block;
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 20px;
    font-family: 'DM Mono', monospace;
    font-size: 14px;
    color: var(--green);
    margin-bottom: 32px;
    letter-spacing: 2px;
  }

  /* DIVIDER */
  .divider {
    height: 1px;
    background: var(--border);
    margin: 24px 0;
  }

  /* MOBILE */
  @media (max-width: 600px) {
    nav { padding: 14px 16px; }
    .hero { padding: 36px 16px 24px; }
    .hero h1 { font-size: 26px; }
    .progress-wrap { padding: 0 16px 24px; }
    .main { padding: 0 16px 60px; }
    .service-grid { grid-template-columns: 1fr; }
    .form-grid { grid-template-columns: 1fr; }
    .form-group.full { grid-column: span 1; }
    .device-grid { grid-template-columns: 1fr 1fr; }
    .time-grid { grid-template-columns: repeat(3, 1fr); }
    .date-grid { gap: 4px; }
    .step-label { display: none; }
  }
</style>
</head>
<body>

<nav>
  <a href="https://www.yourlocaltechguyaua.com" class="nav-logo">
    <div class="nav-logo-icon">🔧</div>
    <div class="nav-logo-text">Your Local <span>Tech Guy</span></div>
  </a>
  <a href="https://www.yourlocaltechguyaua.com" class="nav-back">← Back to site</a>
</nav>

<div class="hero">
  <div class="hero-tag">BOOKING SYSTEM</div>
  <h1>Book a <span>Service</span></h1>
  <p>Select your service, pick a time that works for you, and leave the rest to us. We'll confirm within a few hours.</p>
</div>

<div class="progress-wrap">
  <div class="progress-steps">
    <div class="step active" id="prog-1">
      <div class="step-num">1</div>
      <div class="step-label">Service</div>
    </div>
    <div class="step-line" id="line-1"></div>
    <div class="step" id="prog-2">
      <div class="step-num">2</div>
      <div class="step-label">Date & Time</div>
    </div>
    <div class="step-line" id="line-2"></div>
    <div class="step" id="prog-3">
      <div class="step-num">3</div>
      <div class="step-label">Your Details</div>
    </div>
    <div class="step-line" id="line-3"></div>
    <div class="step" id="prog-4">
      <div class="step-num">4</div>
      <div class="step-label">Confirm</div>
    </div>
  </div>
</div>

<div class="main">

  <!-- STEP 1: SERVICE -->
  <div class="step-panel active" id="panel-1">
    <div class="section-title">Select a service</div>
    <div class="service-grid">
      <div class="service-card" onclick="selectService(this, 'Diagnostics', '40 fl')">
        <div class="service-check">✓</div>
        <div class="service-card-header">
          <div class="service-name">Diagnostics</div>
          <div class="service-price">40 fl</div>
        </div>
        <div class="service-desc">Full system evaluation to pinpoint the issue before any repair begins. Fee credited toward all repairs.</div>
      </div>
      <div class="service-card" onclick="selectService(this, 'System Tune-Up', '85 fl')">
        <div class="service-check">✓</div>
        <div class="service-card-header">
          <div class="service-name">System Tune-Up</div>
          <div class="service-price">85 fl</div>
        </div>
        <div class="service-desc">Physical cleaning, thermal paste replacement & software optimization to restore performance.</div>
      </div>
      <div class="service-card" onclick="selectService(this, 'OS Reinstall', '75 fl')">
        <div class="service-check">✓</div>
        <div class="service-card-header">
          <div class="service-name">OS Reinstall</div>
          <div class="service-price">75 fl</div>
        </div>
        <div class="service-desc">Fresh Windows or macOS install, all updates and driver setup included.</div>
      </div>
      <div class="service-card" onclick="selectService(this, 'Hardware Install', '75 fl')">
        <div class="service-check">✓</div>
        <div class="service-card-header">
          <div class="service-name">Hardware Install</div>
          <div class="service-price">75 fl</div>
        </div>
        <div class="service-desc">Screen, battery, RAM, HDD, SSD, keyboard swaps and more.</div>
      </div>
      <div class="service-card" onclick="selectService(this, 'Custom PC Build', '150 fl')">
        <div class="service-check">✓</div>
        <div class="service-card-header">
          <div class="service-name">Custom PC Build</div>
          <div class="service-price">150 fl</div>
        </div>
        <div class="service-desc">Full assembly, cable management & BIOS configuration for your custom build.</div>
      </div>
      <div class="service-card" onclick="selectService(this, 'Hourly Rate', '65 fl/hr')">
        <div class="service-check">✓</div>
        <div class="service-card-header">
          <div class="service-name">Hourly Rate</div>
          <div class="service-price">65 fl/hr</div>
        </div>
        <div class="service-desc">For complex issues requiring deeper troubleshooting. 1-hour minimum applies.</div>
      </div>
    </div>
    <div class="notice">⚠️ We service <strong>laptops and desktop PCs only</strong> — no tablets or phones.</div>
    <div class="btn-row">
      <button class="btn btn-primary" id="btn-next-1" onclick="goStep(2)" disabled>Continue →</button>
    </div>
  </div>

  <!-- STEP 2: DATE & TIME -->
  <div class="step-panel" id="panel-2">
    <div class="section-title">Pick a date</div>
    <div class="month-nav">
      <button class="month-btn" onclick="changeMonth(-1)">‹</button>
      <div class="month-title" id="month-title"></div>
      <button class="month-btn" onclick="changeMonth(1)">›</button>
    </div>
    <div class="date-grid" id="date-grid"></div>

    <div class="section-title">Available times</div>
    <div class="time-grid" id="time-grid"></div>

    <div class="btn-row">
      <button class="btn btn-secondary" onclick="goStep(1)">← Back</button>
      <button class="btn btn-primary" id="btn-next-2" onclick="goStep(3)" disabled>Continue →</button>
    </div>
  </div>

  <!-- STEP 3: DETAILS -->
  <div class="step-panel" id="panel-3">
    <div class="section-title">Your information</div>
    <div class="form-grid">
      <div class="form-group">
        <label>First Name *</label>
        <input type="text" id="f-fname" placeholder="John" oninput="validateStep3()">
      </div>
      <div class="form-group">
        <label>Last Name *</label>
        <input type="text" id="f-lname" placeholder="Smith" oninput="validateStep3()">
      </div>
      <div class="form-group">
        <label>Phone *</label>
        <input type="tel" id="f-phone" placeholder="(297) 000-0000" oninput="validateStep3()">
      </div>
      <div class="form-group">
        <label>Email</label>
        <input type="email" id="f-email" placeholder="you@email.com">
      </div>
    </div>

    <div class="divider"></div>
    <div class="section-title">Device information</div>
    <div class="device-grid">
      <div class="form-group">
        <label>Type *</label>
        <select id="f-type" onchange="validateStep3()">
          <option value="">Select...</option>
          <option>Laptop</option>
          <option>Desktop PC</option>
        </select>
      </div>
      <div class="form-group">
        <label>Brand</label>
        <input type="text" id="f-brand" placeholder="Dell, HP, Apple...">
      </div>
      <div class="form-group">
        <label>Model</label>
        <input type="text" id="f-model" placeholder="XPS 15, etc.">
      </div>
    </div>

    <div class="form-grid">
      <div class="form-group full">
        <label>Describe the issue</label>
        <textarea id="f-issue" placeholder="Tell us what's happening — error messages, symptoms, when it started..."></textarea>
      </div>
    </div>

    <div class="btn-row">
      <button class="btn btn-secondary" onclick="goStep(2)">← Back</button>
      <button class="btn btn-primary" id="btn-next-3" onclick="goStep(4)" disabled>Continue →</button>
    </div>
  </div>

  <!-- STEP 4: CONFIRM -->
  <div class="step-panel" id="panel-4">
    <div class="section-title">Review your booking</div>
    <div class="summary-card">
      <div class="summary-section" style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
        <div>
          <div class="summary-label">Service</div>
          <div class="summary-value" id="sum-service">—</div>
        </div>
        <div>
          <div class="summary-label">Date & Time</div>
          <div class="summary-value" id="sum-datetime">—</div>
        </div>
      </div>
      <div class="summary-section" style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
        <div>
          <div class="summary-label">Name</div>
          <div class="summary-value" id="sum-name">—</div>
          <div class="summary-sub" id="sum-contact">—</div>
        </div>
        <div>
          <div class="summary-label">Device</div>
          <div class="summary-value" id="sum-device">—</div>
          <div class="summary-sub" id="sum-issue">—</div>
        </div>
      </div>
      <div class="summary-price">
        <div class="summary-price-label">Starting from</div>
        <div class="summary-price-val" id="sum-price">—</div>
      </div>
    </div>

    <div class="notice">
      📋 <strong>What happens next:</strong> We'll review your booking and confirm within a few hours via phone or email. Payment (cash or bank transfer) is due at drop-off.
    </div>

    <div class="btn-row">
      <button class="btn btn-secondary" onclick="goStep(3)">← Back</button>
      <button class="btn btn-primary" onclick="submitBooking()">Confirm Booking ✓</button>
    </div>
  </div>

  <!-- SUCCESS -->
  <div class="step-panel" id="panel-success">
    <div class="success-wrap">
      <div class="success-icon">✓</div>
      <h2>Booking Received!</h2>
      <p>Thanks for booking with Your Local Tech Guy. We'll be in touch shortly to confirm your appointment.</p>
      <div class="booking-ref" id="booking-ref">LTGAUA-000000</div>
      <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap">
        <a href="https://www.yourlocaltechguyaua.com" class="btn btn-secondary">← Back to site</a>
        <a href="tel:+2975639903" class="btn btn-primary">Call us: (297) 563-9903</a>
      </div>
    </div>
  </div>

</div>

<script>
// ── STATE ─────────────────────────────────────────────────────────────────
let state = {
  service: null,
  price: null,
  date: null,
  time: null,
  currentMonth: new Date().getMonth(),
  currentYear: new Date().getFullYear(),
}

const TIMES = ['09:00','09:30','10:00','10:30','11:00','11:30','13:00','13:30','14:00','14:30','15:00','15:30','16:00','16:30']
const UNAVAILABLE = ['10:00','14:00'] // mock unavailable

// ── SERVICE SELECTION ─────────────────────────────────────────────────────
function selectService(el, name, price) {
  document.querySelectorAll('.service-card').forEach(c => c.classList.remove('selected'))
  el.classList.add('selected')
  state.service = name
  state.price = price
  document.getElementById('btn-next-1').disabled = false
}

// ── CALENDAR ──────────────────────────────────────────────────────────────
function renderCalendar() {
  const months = ['January','February','March','April','May','June','July','August','September','October','November','December']
  const today = new Date()
  const y = state.currentYear, m = state.currentMonth

  document.getElementById('month-title').textContent = `${months[m]} ${y}`

  const firstDay = new Date(y, m, 1).getDay()
  const daysInMonth = new Date(y, m + 1, 0).getDate()
  const grid = document.getElementById('date-grid')

  const days = ['Su','Mo','Tu','We','Th','Fr','Sa']
  let html = days.map(d => `<div class="day-label">${d}</div>`).join('')

  for (let i = 0; i < firstDay; i++) html += `<div class="date-cell empty"></div>`

  for (let d = 1; d <= daysInMonth; d++) {
    const date = new Date(y, m, d)
    const isToday = date.toDateString() === today.toDateString()
    const isPast = date < new Date(today.setHours(0,0,0,0))
    const isWeekend = date.getDay() === 0 || date.getDay() === 6
    const dateStr = `${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`
    const isSelected = state.date === dateStr

    let cls = 'date-cell'
    if (isPast || isWeekend) cls += ' disabled'
    if (isToday) cls += ' today'
    if (isSelected) cls += ' selected'

    const clickFn = (!isPast && !isWeekend) ? `onclick="selectDate('${dateStr}')"` : ''
    html += `<div class="${cls}" ${clickFn}>${d}</div>`
  }

  grid.innerHTML = html
}

function selectDate(dateStr) {
  state.date = dateStr
  state.time = null
  renderCalendar()
  renderTimes()
  validateStep2()
}

function changeMonth(dir) {
  state.currentMonth += dir
  if (state.currentMonth > 11) { state.currentMonth = 0; state.currentYear++ }
  if (state.currentMonth < 0)  { state.currentMonth = 11; state.currentYear-- }
  renderCalendar()
}

function renderTimes() {
  const grid = document.getElementById('time-grid')
  if (!state.date) { grid.innerHTML = '<div style="color:var(--muted);font-size:13px;grid-column:span 4">Select a date first</div>'; return }

  grid.innerHTML = TIMES.map(t => {
    const unavail = UNAVAILABLE.includes(t)
    const selected = state.time === t
    let cls = 'time-slot'
    if (unavail) cls += ' unavailable'
    if (selected) cls += ' selected'
    const click = !unavail ? `onclick="selectTime('${t}')"` : ''
    return `<div class="${cls}" ${click}>${t}</div>`
  }).join('')
}

function selectTime(t) {
  state.time = t
  renderTimes()
  validateStep2()
}

function validateStep2() {
  document.getElementById('btn-next-2').disabled = !(state.date && state.time)
}

// ── STEP 3 VALIDATION ─────────────────────────────────────────────────────
function validateStep3() {
  const ok = document.getElementById('f-fname').value.trim() &&
             document.getElementById('f-lname').value.trim() &&
             document.getElementById('f-phone').value.trim() &&
             document.getElementById('f-type').value
  document.getElementById('btn-next-3').disabled = !ok
}

// ── SUMMARY ───────────────────────────────────────────────────────────────
function buildSummary() {
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']
  const [y, m, d] = state.date.split('-')
  const dateStr = `${d} ${months[parseInt(m)-1]} ${y}`

  document.getElementById('sum-service').textContent  = state.service
  document.getElementById('sum-datetime').textContent = `${dateStr} at ${state.time}`
  document.getElementById('sum-price').textContent    = state.price

  const fname = document.getElementById('f-fname').value
  const lname = document.getElementById('f-lname').value
  const phone = document.getElementById('f-phone').value
  const email = document.getElementById('f-email').value

  document.getElementById('sum-name').textContent    = `${fname} ${lname}`
  document.getElementById('sum-contact').textContent = email || phone

  const type  = document.getElementById('f-type').value
  const brand = document.getElementById('f-brand').value
  const model = document.getElementById('f-model').value
  const issue = document.getElementById('f-issue').value

  document.getElementById('sum-device').textContent = [type, brand, model].filter(Boolean).join(' · ') || '—'
  document.getElementById('sum-issue').textContent  = issue ? issue.slice(0,60) + (issue.length > 60 ? '...' : '') : '—'
}

// ── NAVIGATION ────────────────────────────────────────────────────────────
function goStep(n) {
  document.querySelectorAll('.step-panel').forEach(p => p.classList.remove('active'))
  document.getElementById(`panel-${n}`).classList.add('active')

  for (let i = 1; i <= 4; i++) {
    const el = document.getElementById(`prog-${i}`)
    el.classList.remove('active', 'done')
    if (i < n)      el.classList.add('done')
    else if (i === n) el.classList.add('active')
  }

  for (let i = 1; i <= 3; i++) {
    const el = document.getElementById(`line-${i}`)
    el.classList.toggle('done', i < n)
  }

  if (n === 2) { renderCalendar(); renderTimes(); }
  if (n === 4) buildSummary()

  window.scrollTo({ top: 0, behavior: 'smooth' })
}

// ── SUBMIT ────────────────────────────────────────────────────────────────
function submitBooking() {
  const ref = 'LTGAUA-' + Math.random().toString(36).substr(2,6).toUpperCase()
  document.getElementById('booking-ref').textContent = ref

  document.querySelectorAll('.step-panel').forEach(p => p.classList.remove('active'))
  document.getElementById('panel-success').classList.add('active')
  window.scrollTo({ top: 0, behavior: 'smooth' })

  // Here you would normally POST to your backend / Google Calendar API
  console.log('Booking submitted:', {
    ref,
    service: state.service,
    price: state.price,
    date: state.date,
    time: state.time,
    name: `${document.getElementById('f-fname').value} ${document.getElementById('f-lname').value}`,
    phone: document.getElementById('f-phone').value,
    email: document.getElementById('f-email').value,
    device: `${document.getElementById('f-type').value} ${document.getElementById('f-brand').value}`,
    issue: document.getElementById('f-issue').value,
  })
}

// ── INIT ──────────────────────────────────────────────────────────────────
renderCalendar()
renderTimes()
</script>
</body>
</html>